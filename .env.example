# Railway Environment Variables
# For local development: Copy this to .env and fill in values
# For Railway: Set these in Railway dashboard Variables section

# Django Settings
# Generate with: python generate_secret_key.py
DJANGO_SECRET_KEY=change-me-in-railway-dashboard
DEBUG=False

# Allowed Hosts (comma-separated)
# Railway auto-provides: your-app.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1,ritikgaire.com.np,www.ritikgaire.com.np,*.up.railway.app

# Database (Railway PostgreSQL)
# Railway automatically provides DATABASE_URL in production
# Local development example: postgresql://postgres:postgres@localhost:5432/portfolio
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Database SSL (required for Railway PostgreSQL)
DB_SSL_REQUIRE=True

# CSRF Trusted Origins (must include scheme, comma-separated)
CSRF_TRUSTED_ORIGINS=https://ritikgaire.com.np,https://www.ritikgaire.com.np,https://*.up.railway.app

# Security Settings (enable in production)
SECURE_SSL_REDIRECT=True
